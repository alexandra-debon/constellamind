# Public values live in .env (committed). Copy this file to .env.local (never
# committed) to override them locally. In GitHub Actions, set the
# same names as repository variables (Settings → Secrets and variables → Actions → Variables).

# Supabase project (Project Settings → API). The anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Project settings → API keys → Public app-specific keys)
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# RevenueCat Web Billing purchase link (Web → Web Purchase Links), without the trailing user id
VITE_WEB_PURCHASE_LINK=

# Public site hosting privacy.html and terms.html
VITE_SITE_URL=https://alexandra-debon.github.io/constellamind
